{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "MicroCMS": "Debug"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=microcms_dev.db"
  },
  "MicroCMS": {
    "Database": {
      "Provider": "Sqlite",
      "IsolationMode": "RowLevel"
    },
    "Cache": {
      "Provider": "InMemory"
    },
    "Storage": {
      "Provider": "DATABASE",
      "Database": {
        "CachePath": "App_Data\\media-cache",
        "MaxCachedFileSizeBytes": 52428800
      }
    },
    "Search": {
      "Provider": "OpenSearch",
      "Endpoint": "http://localhost:9200"
    },
    "Ai": {
      "DefaultProvider": "ollama",
      "EnabledFeatures": ["DraftGeneration", "SemanticSearch"],
      "BudgetEnabled": false
    },
    "Plugins": {
      "Directory": "./plugins",
      "EnableSignatureVerification": false
    }
  },
  "ClamAv": {
    "Enabled": false
  }
}
