{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore": "Warning"
        },
        "File": {
            "Path": "App_Data\\logs\\microcms-.log",
            "RollingInterval": "Day",
            "RetainedFileCountLimit": 31
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Port=5432;Database=microcms_db;Username=postgres;Password=M@n@s0000"
    },
    "TrustedClients": {
        "Admin": {
            "Secret": "5DE7C44A99A04FF4A9241CE81BA3DDF9",
            "Issuer": "microcms-admin",
            "Audience": "microcms-api",
            "AccessTokenMinutes": 15
        }
    },
    "MicroCMS": {
        "Database": {
            "Provider": "PostgreSql",
            "IsolationMode": "SchemaPerTenant"
        },
        "Cache": {
            "Provider": "InMemory",
            "ConnectionString": "localhost:6379"
        },
        "Storage": {
            "Provider": "DATABASE",
            "Database": {
                "CachePath": "App_Data\\media-cache",
                "MaxCachedFileSizeBytes": 52428800
            }
        },
        "Search": {
            "Provider": "OpenSearch",
            "Endpoint": "http://localhost:9200"
        },
        "Ai": {
            "DefaultProvider": "openai",
            "EnabledFeatures": [],
            "BudgetEnabled": true
        },
        "Outbox": {
            "InstanceId": "CM"
        },
        "Plugins": {
            "Directory": "/plugins",
            "EnableSignatureVerification": true
        },
        "Media": {
            "AllowedExtensions": [
                ".jpg", ".jpeg", ".png", ".gif", ".webp", ".avif", ".svg",
                ".mp4", ".mov", ".avi", ".webm",
                ".mp3", ".wav", ".ogg",
                ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx",
                ".zip", ".tar", ".gz",
                ".js", ".mjs", ".css",
                ".html", ".htm", ".xml", ".json", ".txt",
                ".woff", ".woff2", ".ttf", ".otf"
            ],
            "ExtensionMimeTypes": {
                ".jpg":   "image/jpeg",
                ".jpeg":  "image/jpeg",
                ".png":   "image/png",
                ".gif":   "image/gif",
                ".webp":  "image/webp",
                ".svg":   "image/svg+xml",
                ".avif":  "image/avif",
                ".bmp":   "image/bmp",
                ".tif":   "image/tiff",
                ".tiff":  "image/tiff",
                ".mp4":   "video/mp4",
                ".mov":   "video/quicktime",
                ".avi":   "video/x-msvideo",
                ".webm":  "video/webm",
                ".mp3":   "audio/mpeg",
                ".wav":   "audio/wav",
                ".ogg":   "audio/ogg",
                ".pdf":   "application/pdf",
                ".doc":   "application/msword",
                ".docx":  "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
                ".xls":   "application/vnd.ms-excel",
                ".xlsx":  "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                ".ppt":   "application/vnd.ms-powerpoint",
                ".pptx":  "application/vnd.openxmlformats-officedocument.presentationml.presentation",
                ".zip":   "application/zip",
                ".tar":   "application/x-tar",
                ".gz":    "application/gzip",
                ".js":    "text/javascript",
                ".mjs":   "text/javascript",
                ".css":   "text/css",
                ".html":  "text/html",
                ".htm":   "text/html",
                ".xml":   "application/xml",
                ".json":  "application/json",
                ".txt":   "text/plain",
                ".woff":  "font/woff",
                ".woff2": "font/woff2",
                ".ttf":   "font/ttf",
                ".otf":   "font/otf"
            }
        }
    }
}
