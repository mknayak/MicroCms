{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore": "Warning"
        },
        "File": {
            "Path": "App_Data\\logs\\microcms-.log",
            "RollingInterval": "Day",
            "RetainedFileCountLimit": 31
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Port=5432;Database=microcms_db;Username=postgres;Password=M@n@s0000"
    },
    "TrustedClients": {
        "Admin": {
            "Secret": "5DE7C44A99A04FF4A9241CE81BA3DDF9",
            "Issuer": "microcms-admin",
            "Audience": "microcms-api",
            "AccessTokenMinutes": 15
        }
    },
    "MicroCMS": {
        "Database": {
            "Provider": "PostgreSql",
            "IsolationMode": "SchemaPerTenant"
        },
        "Cache": {
            "Provider": "InMemory",
            "ConnectionString": "localhost:6379"
        },
        "Storage": {
            "Provider": "DATABASE",
            "Database": {
                "CachePath": "App_Data\\media-cache",
                "MaxCachedFileSizeBytes": 52428800
            }
        },
        "Search": {
            "Provider": "OpenSearch",
            "Endpoint": "http://localhost:9200"
        },
        "Ai": {
            "DefaultProvider": "openai",
            "EnabledFeatures": [],
            "BudgetEnabled": true
        },
        "Outbox": {
            "InstanceId": "CM"
        },
        "Plugins": {
            "Directory": "/plugins",
            "EnableSignatureVerification": true
        }
    }
}
