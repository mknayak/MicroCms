{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",

  "SiteHost": {
    "DeliveryBaseUrl": "http://localhost:5200",
    "DefaultSite": {
        "SiteId": "1ba7bae3-624b-4b0e-9046-e957d4dd3264",
        "ApiKey": "mck_DUySb3HRPBbiF0nvrVnqkKnPkD6ctxS6DPaQkPq5LMY",
        "DefaultLocale": "en"
    },

    "Sites": [
        {
            "Hostname": "localhost",
            "SiteId": "1ba7bae3-624b-4b0e-9046-e957d4dd3264",
            "ApiKey": "mck_DUySb3HRPBbiF0nvrVnqkKnPkD6ctxS6DPaQkPq5LMY",
            "DefaultLocale": "en"
        },
      {
        "Hostname": "site-a.com",
        "SiteId": "00000000-0000-0000-0000-000000000001",
        "ApiKey": "mck_site_a_key",
        "DefaultLocale": "en"
      },
      {
        "Hostname": "site-b.com",
        "SiteId": "00000000-0000-0000-0000-000000000002",
        "ApiKey": "mck_site_b_key",
        "DefaultLocale": "fr"
      }
    ]
  },

  "ReverseProxy": {
    "Routes": {
      "delivery-home": {
        "ClusterId": "delivery",
        "Match": { "Path": "/" },
        "Transforms": [
          { "PathPattern": "/api/delivery/pages/home/render" }
        ]
      },
      "delivery-pages": {
        "ClusterId": "delivery",
        "Match": { "Path": "/{slug}" },
        "Transforms": [
          { "PathPattern": "/api/delivery/pages/{slug}/render" }
        ]
      }
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Yarp": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "App_Data/logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
