@model EntryFormViewModel
@{
    var entry = Model.Existing!;
    var ct    = Model.ContentType;
    ViewData["Title"] = entry.Slug;
}

@section Styles {
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.snow.min.css"
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    <style>
        .quill-editor-wrapper .ql-toolbar { border-top:none; border-left:none; border-right:none; border-radius:0; }
        .quill-editor-wrapper .ql-container { border:none; }
        .ql-editor { min-height:200px; }
    </style>
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small mb-1">
            <li class="breadcrumb-item"><a asp-controller="ContentTypes" asp-action="Index">Content Types</a></li>
            <li class="breadcrumb-item"><a asp-controller="ContentTypes" asp-action="Detail" asp-route-id="@ct.Id">@ct.DisplayName</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" asp-route-contentTypeId="@ct.Id">Entries</a></li>
            <li class="breadcrumb-item active">@entry.Slug</li>
        </ol>
    </nav>
    <div class="d-flex align-items-center gap-3">
        <div class="rounded-2 p-2 bg-primary bg-opacity-10 text-primary" style="font-size:1.4rem;">
            <i class="bi bi-file-earmark-text"></i>
        </div>
        <div>
            <h1 class="h4 fw-bold mb-0">@entry.Slug</h1>
            <small class="text-muted">
                <code>@ct.Handle</code> &middot;
                Version @entry.CurrentVersionNumber &middot;
                @await Html.PartialAsync("_StatusBadge", entry.Status)
            </small>
        </div>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@entry.Id" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    @await Html.PartialAsync("_EntryForm", Model)
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.min.js"
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
    // Location: combine lat/lng into hidden combined field
    document.querySelectorAll('.location-combined').forEach(function(hidden) {
        var baseName = hidden.name;
        var lat = document.querySelector('[name="' + baseName + '_lat"]');
        var lng = document.querySelector('[name="' + baseName + '_lng"]');
        if (!lat || !lng) return;
        function upd() { hidden.value = lat.value + ',' + lng.value; }
        lat.addEventListener('input', upd);
        lng.addEventListener('input', upd);
    });

    // Quill rich-text editor
    (function() {
        var toolbar = [
            [{ header: [1,2,3,false] }],
            ['bold','italic','underline','strike'],
            ['blockquote','code-block'],
            [{ list:'ordered' }, { list:'bullet' }],
            [{ indent:'-1' }, { indent:'+1' }],
            ['link'],
            ['clean']
        ];
        document.querySelectorAll('.quill-editor').forEach(function(el) {
            var hidden = document.getElementById(el.dataset.inputId);
            var q = new Quill(el, { theme:'snow', modules:{ toolbar:toolbar } });
            function sync() { if (hidden) hidden.value = q.root.innerHTML === '<p><br></p>' ? '' : q.root.innerHTML; }
            q.on('text-change', sync);
            var form = el.closest('form');
            if (form) form.addEventListener('submit', sync);
        });
    })();

    // MultiList tag-input
    (function() {
        document.querySelectorAll('.multilist-widget').forEach(function(w) {
            var hidden = document.getElementById(w.dataset.inputId);
            var tagsEl = w.querySelector('.multilist-tags');
            var input  = w.querySelector('.multilist-input');
            var addBtn = w.querySelector('.multilist-add');
            var vals   = (hidden.value || '').split('\n').map(function(v){ return v.trim(); }).filter(Boolean);

            function sync() { hidden.value = vals.join('\n'); }
            function render() {
                tagsEl.innerHTML = '';
                vals.forEach(function(v, i) {
                    var t = document.createElement('span');
                    t.className = 'badge bg-primary d-inline-flex align-items-center gap-1 py-1 px-2';
                    t.style.fontSize = '.8rem';
                    t.innerHTML = '<span>' + v.replace(/&/g,'&amp;').replace(/</g,'&lt;') + '</span>' +
                        '<button type="button" class="btn-close btn-close-white ms-1" aria-label="Remove" style="font-size:.5rem;"></button>';
                    t.querySelector('.btn-close').addEventListener('click', function() { vals.splice(i,1); sync(); render(); });
                    tagsEl.appendChild(t);
                });
            }
            function add() {
                var v = input.value.trim();
                if (v && !vals.includes(v)) { vals.push(v); sync(); render(); }
                input.value = ''; input.focus();
            }
            addBtn.addEventListener('click', add);
            input.addEventListener('keydown', function(e){ if(e.key==='Enter'){ e.preventDefault(); add(); } });
            tagsEl.addEventListener('click', function(){ input.focus(); });
            render();
        });
    })();

    // Asset Picker
    (function() {
        var tid = null;
        document.querySelectorAll('.asset-picker-btn').forEach(function(b){ b.addEventListener('click', function(){ tid = this.dataset.targetId; }); });

        function loadAssets(search, mtype) {
            var res  = document.getElementById('assetPickerResults');
            var emp  = document.getElementById('assetPickerEmpty');
            var spin = document.getElementById('assetPickerLoading');
            var cnt  = document.getElementById('assetPickerCount');
            res.innerHTML=''; emp.classList.add('d-none'); spin.classList.remove('d-none'); cnt.textContent='';

            fetch('/Media/Picker?page=1&search=' + encodeURIComponent(search||'') + '&mediaType=' + encodeURIComponent(mtype||''),
                  { headers:{ 'X-Requested-With':'XMLHttpRequest' } })
            .then(function(r){ return r.json(); })
            .then(function(d) {
                spin.classList.add('d-none');
                var items = d.items || [];
                cnt.textContent = (d.totalCount||0) + ' asset(s)';
                if (!items.length) { emp.classList.remove('d-none'); return; }
                items.forEach(function(a) {
                    var col = document.createElement('div');
                    col.className = 'col-6 col-sm-4 col-md-3 col-lg-2';
                    var isImg = (a.mediaType||'').toLowerCase()==='image';
                    var thumb = a.thumbnailUrl || a.url || '';
                    col.innerHTML = '<div class="card h-100 asset-pick-card" role="button" style="cursor:pointer;" data-id="' + (a.id||'') + '">' +
                        (isImg && thumb ? '<img src="' + thumb + '" class="card-img-top" style="height:72px;object-fit:cover;" alt="">' :
                         '<div class="text-center py-3 bg-light"><i class="bi bi-file-earmark fs-3 text-muted"></i></div>') +
                        '<div class="card-body p-1"><small class="text-truncate d-block" title="' + (a.fileName||'') + '">' + (a.fileName||'') + '</small></div></div>';
                    col.querySelector('.asset-pick-card').addEventListener('click', function() {
                        var t = document.getElementById(tid);
                        if (t) {
                            t.value = this.dataset.id;
                            var h = t.closest('.mb-3')?.querySelector('.form-text');
                            if (h) h.innerHTML = '<span class="text-success"><i class="bi bi-check-circle me-1"></i>Asset selected.</span>';
                        }
                        bootstrap.Modal.getInstance(document.getElementById('assetPickerModal')).hide();
                    });
                    res.appendChild(col);
                });
            })
            .catch(function(){ spin.classList.add('d-none'); res.innerHTML='<div class="col-12"><div class="alert alert-danger">Failed to load assets.</div></div>'; });
        }

        var modal = document.getElementById('assetPickerModal');
        if (modal) modal.addEventListener('show.bs.modal', function() {
            document.getElementById('assetPickerSearch').value='';
            document.getElementById('assetPickerType').value='';
            loadAssets('','');
        });
        document.getElementById('assetPickerSearchBtn')?.addEventListener('click', function() {
            loadAssets(document.getElementById('assetPickerSearch').value, document.getElementById('assetPickerType').value);
        });
        document.getElementById('assetPickerSearch')?.addEventListener('keydown', function(e) {
            if (e.key==='Enter') { e.preventDefault(); loadAssets(this.value, document.getElementById('assetPickerType').value); }
        });
    })();

    // Entry Picker
    (function() {
        var tid = null;
        document.querySelectorAll('.entry-picker-btn').forEach(function(b){ b.addEventListener('click', function(){ tid = this.dataset.targetId; }); });

        function loadEntries(search) {
            var res  = document.getElementById('entryPickerResults');
            var emp  = document.getElementById('entryPickerEmpty');
            var spin = document.getElementById('entryPickerLoading');
            var cnt  = document.getElementById('entryPickerCount');
            res.innerHTML=''; emp.classList.add('d-none'); spin.classList.remove('d-none'); cnt.textContent='';

            fetch('/Entries/Picker?page=1&search=' + encodeURIComponent(search||''),
                  { headers:{ 'X-Requested-With':'XMLHttpRequest' } })
            .then(function(r){ return r.json(); })
            .then(function(d) {
                spin.classList.add('d-none');
                var items = d.items || [];
                cnt.textContent = (d.totalCount||0) + ' entry/entries';
                if (!items.length) { emp.classList.remove('d-none'); return; }
                var html = '<div class="table-responsive"><table class="table table-hover align-middle mb-0 small"><thead class="table-light"><tr><th>Title / Slug</th><th>Type</th><th>Locale</th><th>Status</th><th></th></tr></thead><tbody>';
                items.forEach(function(e) {
                    var css = e.status==='Published' ? 'bg-success' : e.status==='Draft' ? 'bg-secondary' : 'bg-warning text-dark';
                    html += '<tr><td><span class="fw-semibold">' + (e.title||e.slug) + '</span><br><code class="text-muted">' + e.slug + '</code></td>' +
                        '<td class="text-muted">' + (e.contentTypeName||'') + '</td>' +
                        '<td><span class="badge bg-light text-dark border">' + e.locale + '</span></td>' +
                        '<td><span class="badge ' + css + '">' + e.status + '</span></td>' +
                        '<td><button type="button" class="btn btn-sm btn-primary pick-entry-btn" data-id="' + e.id + '">Select</button></td></tr>';
                });
                html += '</tbody></table></div>';
                res.innerHTML = html;
                res.querySelectorAll('.pick-entry-btn').forEach(function(b) {
                    b.addEventListener('click', function() {
                        var t = document.getElementById(tid);
                        if (t) {
                            t.value = this.dataset.id;
                            var h = t.closest('.mb-3')?.querySelector('.form-text');
                            if (h) h.innerHTML = '<span class="text-success"><i class="bi bi-check-circle me-1"></i>Entry selected.</span>';
                        }
                        bootstrap.Modal.getInstance(document.getElementById('entryPickerModal')).hide();
                    });
                });
            })
            .catch(function(){ spin.classList.add('d-none'); res.innerHTML='<div class="alert alert-danger">Failed to load entries.</div>'; });
        }

        var modal = document.getElementById('entryPickerModal');
        if (modal) modal.addEventListener('show.bs.modal', function() {
            document.getElementById('entryPickerSearch').value='';
            loadEntries('');
        });
        document.getElementById('entryPickerSearchBtn')?.addEventListener('click', function() { loadEntries(document.getElementById('entryPickerSearch').value); });
        document.getElementById('entryPickerSearch')?.addEventListener('keydown', function(e) {
            if (e.key==='Enter') { e.preventDefault(); loadEntries(this.value); }
        });
    })();
    </script>
}
