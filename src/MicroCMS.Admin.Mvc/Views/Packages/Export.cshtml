@{
    ViewData["Title"] = "Export Package";
    var categories = new[]
    {
        ("ContentTypes", "bi-layout-text-sidebar-reverse", "Content Types", "All content type schemas"),
        ("Entries",      "bi-file-earmark-text",           "Entries",        "Published and draft entries"),
        ("Media",        "bi-images",                      "Media",          "Media asset metadata"),
        ("Taxonomies",   "bi-tags",                        "Taxonomies",     "Tags and category trees"),
        ("Components",   "bi-puzzle",                      "Components",     "Reusable component definitions"),
        ("Layouts",      "bi-layout-sidebar",              "Layouts",        "Page layouts"),
        ("Users",        "bi-people",                      "Users",          "User accounts and roles (SystemAdmin only)"),
        ("Settings",     "bi-gear",                        "Settings",       "Tenant and site configuration"),
    };
}

<div class="mb-4">
    <h1 class="h4 fw-bold mb-1">Export Package</h1>
    <p class="text-muted">Download content, schemas and configuration as a ZIP package.</p>
</div>

<div class="alert alert-info d-flex align-items-start gap-2 mb-4" style="max-width:640px;">
    <i class="bi bi-info-circle-fill mt-1"></i>
    <div class="small">
        Only items accessible to your current role will be exported. Sensitive data such as passwords
        and API secrets is never included. The resulting ZIP can be re-imported into any MicroCMS instance.
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 fw-semibold d-flex justify-content-between align-items-center">
                <span><i class="bi bi-boxes me-2 text-primary"></i>What to Export</span>
                <div>
                    <button type="button" class="btn btn-link btn-sm p-0 me-2" id="selectAll">Select all</button>
                    <button type="button" class="btn btn-link btn-sm p-0 text-muted" id="deselectAll">None</button>
                </div>
            </div>
            <div class="card-body">
                <form asp-action="Export" method="post">
                    @Html.AntiForgeryToken()

                    @* Categories *@
                    <div class="row g-2 mb-4">
                        @foreach (var (key, icon, label, desc) in categories)
                        {
                            <div class="col-sm-6">
                                <div class="form-check d-flex align-items-start gap-2 p-2 border rounded-2 category-card">
                                    <input class="form-check-input mt-1 category-checkbox flex-shrink-0"
                                           type="checkbox" id="cat_@key" name="categories" value="@key"
                                           checked />
                                    <label class="form-check-label" for="cat_@key">
                                        <span class="fw-semibold d-flex align-items-center gap-1">
                                            <i class="bi @icon text-primary"></i> @label
                                        </span>
                                        <small class="text-muted">@desc</small>
                                    </label>
                                </div>
                            </div>
                        }
                    </div>

                    @* Site filter *@
                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-globe me-1 text-muted"></i>Scope to Site
                        </label>
                        <select name="siteId" class="form-select">
                            <option value="">All sites (tenant-wide)</option>
                            @* Sites populated from TempData if available, otherwise show text input *@
                        </select>
                        <div class="form-text">
                            Or paste a specific Site ID:
                            <input type="text" name="siteId" class="form-control form-control-sm mt-1 font-monospace"
                                   placeholder="Leave blank to export all sites" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-download me-1"></i>Export &amp; Download
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm bg-light border-dashed">
            <div class="card-body p-4">
                <h6 class="fw-semibold mb-3">
                    <i class="bi bi-question-circle me-2 text-primary"></i>About Packages
                </h6>
                <ul class="list-unstyled small text-muted mb-0">
                    <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Packages are standard ZIP files containing JSON data.</li>
                    <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>IDs are preserved so you can round-trip between environments.</li>
                    <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Import respects existing records — duplicates are skipped.</li>
                    <li class="mb-2"><i class="bi bi-exclamation-triangle text-warning me-2"></i>Large entry sets may take a few seconds to generate.</li>
                    <li class="mb-0"><i class="bi bi-shield-check text-info me-2"></i>Passwords and secrets are never exported.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Select-all / deselect-all
        document.getElementById('selectAll').addEventListener('click', function () {
            document.querySelectorAll('.category-checkbox').forEach(cb => cb.checked = true);
        });
        document.getElementById('deselectAll').addEventListener('click', function () {
            document.querySelectorAll('.category-checkbox').forEach(cb => cb.checked = false);
        });

        // Highlight checked categories
        document.querySelectorAll('.category-checkbox').forEach(function (cb) {
            cb.addEventListener('change', function () {
                this.closest('.category-card').classList.toggle('border-primary', this.checked);
                this.closest('.category-card').classList.toggle('bg-primary', false);
            });
            cb.dispatchEvent(new Event('change'));
        });
    </script>
}
