@using MicroCMS.Admin.Mvc.Models.ApiDtos
@{
    ViewData["Title"] = "Taxonomy";
    var categories = ViewBag.Categories as List<CategoryDto> ?? [];
    var tags = ViewBag.Tags as List<TagDto> ?? [];
}

<h1 class="h4 fw-bold mb-4">Taxonomy</h1>

<div class="row g-3">
    @* ── Categories ──────────────────────────────────────────────────────────── *@
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold border-0 d-flex justify-content-between align-items-center">
                <span><i class="bi bi-diagram-3 me-2 text-primary"></i>Categories (@categories.Count)</span>
                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#newCategoryModal">
                    <i class="bi bi-plus"></i> Add
                </button>
            </div>
            @if (categories.Count == 0)
            {
                <div class="card-body text-center text-muted py-4">No categories yet.</div>
            }
            else
            {
                <ul class="list-group list-group-flush small">
                    @foreach (var cat in categories)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-semibold">@cat.Name</span>
                                <small class="text-muted ms-2">@cat.Slug</small>
                                <span class="badge bg-light text-dark border ms-2">@cat.EntryCount</span>
                            </div>
                            <form asp-action="DeleteCategory" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete @cat.Name?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@cat.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    @* ── Tags ────────────────────────────────────────────────────────────────── *@
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold border-0 d-flex justify-content-between align-items-center">
                <span><i class="bi bi-tag me-2 text-primary"></i>Tags (@tags.Count)</span>
                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#newTagModal">
                    <i class="bi bi-plus"></i> Add
                </button>
            </div>
            @if (tags.Count == 0)
            {
                <div class="card-body text-center text-muted py-4">No tags yet.</div>
            }
            else
            {
                <div class="card-body d-flex flex-wrap gap-2 pb-2">
                    @foreach (var tag in tags)
                    {
                        <span class="badge bg-light text-dark border d-flex align-items-center gap-1" style="font-size:.85rem;">
                            @tag.Name
                            <span class="badge bg-secondary ms-1">@tag.EntryCount</span>
                            <form asp-action="DeleteTag" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete tag @tag.Name?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@tag.Id" />
                                <button type="submit" class="btn btn-link btn-sm p-0 text-danger" title="Delete">
                                    <i class="bi bi-x"></i>
                                </button>
                            </form>
                        </span>
                    }
                </div>
            }
        </div>
    </div>
</div>

@* ── New category modal ──────────────────────────────────────────────────────── *@
<div class="modal fade" id="newCategoryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">New Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateCategory" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Name</label>
                        <input type="text" name="name" class="form-control" placeholder="Technology" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Slug</label>
                        <input type="text" name="slug" class="form-control font-monospace" placeholder="technology" required />
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── New tag modal ───────────────────────────────────────────────────────────── *@
<div class="modal fade" id="newTagModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">New Tag</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateTag" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Name</label>
                        <input type="text" name="name" class="form-control" placeholder="dotnet" required />
                    </div>
                    <div>
                        <label class="form-label fw-semibold">Slug</label>
                        <input type="text" name="slug" class="form-control font-monospace" placeholder="dotnet" required />
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>
