@using MicroCMS.Admin.Mvc.Models.ApiDtos
@model TenantDetail
@{
    ViewData["Title"] = "Settings";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h4 fw-bold mb-0">Organisation Settings</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Slug))
        {
            <small class="text-muted"><code>@Model.Slug</code></small>
        }
    </div>
</div>

<div class="row g-4">

    @* ── Org settings form ────────────────────────────────────────────────────── *@
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 fw-semibold">
                <i class="bi bi-building me-2 text-primary"></i>Organisation Details
            </div>
            <div class="card-body p-4">
                <form asp-action="Index" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Display Name</label>
                        <input type="text" name="DisplayName" value="@Model.DisplayName"
                               class="form-control" required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold">Default Locale</label>
                            <input type="text" name="DefaultLocale" value="@Model.DefaultLocale"
                                   class="form-control" placeholder="en" />
                            <div class="form-text">e.g. <code>en</code>, <code>fr</code>, <code>de</code></div>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold">Time Zone</label>
                            <input type="text" name="TimeZoneId" value="@Model.TimeZoneId"
                                   class="form-control" placeholder="UTC" />
                            <div class="form-text">IANA time zone, e.g. <code>Europe/London</code></div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Logo URL</label>
                        <input type="url" name="LogoUrl" value="@Model.LogoUrl"
                               class="form-control" placeholder="https://…" />
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="aiEnabled"
                                   name="AiEnabled" value="true"
                                   @(Model.AiEnabled ? "checked" : "") />
                            <label class="form-check-label fw-semibold" for="aiEnabled">
                                AI Features
                            </label>
                        </div>
                        <div class="form-text ms-4">Enable AI-assisted content editing and suggestions.</div>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>Save Settings
                    </button>
                </form>
            </div>
        </div>
    </div>

    @* ── Quick links ──────────────────────────────────────────────────────────── *@
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white border-0 fw-semibold">
                <i class="bi bi-grid me-2 text-primary"></i>Quick Links
            </div>
            <div class="list-group list-group-flush">
                <a asp-controller="Users" asp-action="Index"
                   class="list-group-item list-group-item-action d-flex align-items-center gap-2">
                    <i class="bi bi-people text-primary"></i>
                    <div>
                        <div class="fw-semibold">Users &amp; Roles</div>
                        <small class="text-muted">Invite team members and manage permissions</small>
                    </div>
                    <i class="bi bi-chevron-right ms-auto text-muted"></i>
                </a>
                <a asp-controller="Packages" asp-action="Export"
                   class="list-group-item list-group-item-action d-flex align-items-center gap-2">
                    <i class="bi bi-box-arrow-up text-success"></i>
                    <div>
                        <div class="fw-semibold">Export Package</div>
                        <small class="text-muted">Download content as a ZIP backup</small>
                    </div>
                    <i class="bi bi-chevron-right ms-auto text-muted"></i>
                </a>
                <a asp-controller="Packages" asp-action="Import"
                   class="list-group-item list-group-item-action d-flex align-items-center gap-2">
                    <i class="bi bi-box-arrow-in-down text-warning"></i>
                    <div>
                        <div class="fw-semibold">Import Package</div>
                        <small class="text-muted">Restore or migrate content</small>
                    </div>
                    <i class="bi bi-chevron-right ms-auto text-muted"></i>
                </a>
            </div>
        </div>

        @* ── Sites table ──────────────────────────────────────────────────────── *@
        @if (Model.Sites.Count > 0)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 fw-semibold">
                    <i class="bi bi-globe me-2 text-primary"></i>Sites (@Model.Sites.Count)
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Handle</th>
                                <th>Domain</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var site in Model.Sites)
                            {
                                <tr>
                                    <td class="fw-semibold">@site.Name</td>
                                    <td><code class="text-muted">@site.Handle</code></td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(site.CustomDomain))
                                        {
                                            <small class="text-muted font-monospace">@site.CustomDomain</small>
                                        }
                                        else
                                        {
                                            <small class="text-muted">—</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @(site.IsActive ? "bg-success" : "bg-secondary")">
                                            @(site.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Sites" asp-action="Settings"
                                           asp-route-id="@site.Id"
                                           class="btn btn-outline-secondary btn-sm">
                                            <i class="bi bi-gear"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
