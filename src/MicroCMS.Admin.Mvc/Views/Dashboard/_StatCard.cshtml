@model (string Icon, string Label, string Value, string Color)

<div class="card border-0 shadow-sm">
    <div class="card-body d-flex align-items-center gap-3">
        <div class="stat-icon bg-@Model.Color bg-opacity-10 text-@Model.Color rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
             style="width:48px;height:48px;font-size:1.4rem;">
            <i class="bi @Model.Icon"></i>
        </div>
        <div>
            <div class="h5 fw-bold mb-0">@Model.Value</div>
            <small class="text-muted">@Model.Label</small>
        </div>
    </div>
</div>
