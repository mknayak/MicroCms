@using MicroCMS.Admin.Mvc.Models.ApiDtos
@model SiteSettingsDto
@{
    var site = ViewBag.Site as SiteDetailDto;
    ViewData["Title"] = $"{site?.Name} — Settings";
}

<div class="mb-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Tenants" asp-action="Index">Tenants</a></li>
            @if (site is not null)
            {
                <li class="breadcrumb-item">
                    <a asp-controller="Tenants" asp-action="Detail" asp-route-id="@site.TenantId">Tenant</a>
                </li>
            }
            <li class="breadcrumb-item active">@(site?.Name ?? "Site") Settings</li>
        </ol>
    </nav>

    <div class="d-flex align-items-center gap-3">
        <div class="rounded-2 p-2 bg-primary bg-opacity-10 text-primary" style="font-size:1.4rem;">
            <i class="bi bi-globe"></i>
        </div>
        <div>
            <h1 class="h4 fw-bold mb-0">@(site?.Name ?? "Site") — Settings</h1>
            @if (site is not null)
            {
                <small class="text-muted"><code>@site.Handle</code></small>
            }
        </div>
    </div>
</div>

@* ── Single form — all tabs share it ─────────────────────────────────────────── *@
<form asp-action="Settings" asp-route-id="@site?.Id" method="post" id="settingsForm">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    @* ── JS Tab bar ───────────────────────────────────────────────────────────── *@
    <ul class="nav nav-tabs border-bottom mb-4" id="settingsTabs">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-general" type="button">
                <i class="bi bi-info-circle me-1"></i>General
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-features" type="button">
                <i class="bi bi-toggles me-1"></i>Features
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-locales" type="button">
                <i class="bi bi-translate me-1"></i>Locales
                <span class="badge bg-secondary ms-1 small">@Model.Locales.Count</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-cors" type="button">
                <i class="bi bi-shield-check me-1"></i>CORS
                <span class="badge bg-secondary ms-1 small">@Model.CorsOrigins.Count</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-apikeys" type="button">
                <i class="bi bi-key me-1"></i>API Keys
            </button>
        </li>
    </ul>

    <div class="tab-content">

        @* ── General tab ─────────────────────────────────────────────────────────── *@
        <div class="tab-pane fade show active" id="tab-general">
            <div class="row">
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white border-0 fw-semibold">General Information</div>
                        <div class="card-body p-4">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Site Name</label>
                                <input type="text" class="form-control" value="@site?.Name" disabled />
                                <div class="form-text text-muted">Contact support to rename a site.</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Handle</label>
                                <input type="text" class="form-control font-monospace" value="@site?.Handle" disabled />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Preview URL Template</label>
                                <input asp-for="PreviewUrlTemplate" class="form-control font-monospace"
                                       placeholder="https://mysite.com/preview/{{entry.id}}" />
                                <div class="form-text">Use <code>{{"{{"}}entry.id{{"}}"}}</code> as placeholder for the entry ID.</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm bg-light">
                        <div class="card-body p-4 small">
                            <h6 class="fw-semibold mb-3"><i class="bi bi-info-circle me-2 text-primary"></i>Site Details</h6>
                            <dl class="row mb-0">
                                <dt class="col-sm-4 text-muted">ID</dt>
                                <dd class="col-sm-8">
                                    <div class="input-group input-group-sm">
                                        <input type="text" class="form-control font-monospace" value="@site?.Id"
                                               id="siteIdField" readonly />
                                        <button type="button" class="btn btn-outline-secondary" onclick="copyField('siteIdField')">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    </div>
                                </dd>
                                <dt class="col-sm-4 text-muted mt-2">Domain</dt>
                                <dd class="col-sm-8 mt-2">@(site?.CustomDomain ?? "—")</dd>
                                <dt class="col-sm-4 text-muted">Status</dt>
                                <dd class="col-sm-8">
                                    <span class="badge @(site?.IsActive == true ? "bg-success" : "bg-secondary")">
                                        @(site?.IsActive == true ? "Active" : "Inactive")
                                    </span>
                                </dd>
                                <dt class="col-sm-4 text-muted">Created</dt>
                                <dd class="col-sm-8">@(site?.CreatedAt?.Length >= 10 ? site.CreatedAt[..10] : site?.CreatedAt)</dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ── Features tab ─────────────────────────────────────────────────────────── *@
        <div class="tab-pane fade" id="tab-features">
            <div class="row">
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white border-0 fw-semibold">Feature Flags</div>
                        <div class="card-body p-4">
                            @{
                                var features = new[]
                                {
                                    ("VersioningEnabled",  Model.VersioningEnabled,  "Versioning",  "Track change history for every entry"),
                                    ("WorkflowEnabled",    Model.WorkflowEnabled,    "Workflow",    "Enable draft → review → publish stages"),
                                    ("SchedulingEnabled",  Model.SchedulingEnabled,  "Scheduling",  "Schedule entries to publish at a future date"),
                                    ("PreviewEnabled",     Model.PreviewEnabled,     "Preview",     "Let editors preview draft content"),
                                    ("AiEnabled",          Model.AiEnabled,          "AI Features", "AI-assisted writing and suggestions"),
                                };
                            }
                            @foreach (var (propName, value, label, desc) in features)
                            {
                                <div class="d-flex align-items-start justify-content-between mb-4">
                                    <div>
                                        <div class="fw-semibold">@label</div>
                                        <small class="text-muted">@desc</small>
                                    </div>
                                    <div class="form-check form-switch ms-3 flex-shrink-0">
                                        <input class="form-check-input" type="checkbox"
                                               name="@propName" value="true"
                                               @(value ? "checked" : "") />
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ── Locales tab ──────────────────────────────────────────────────────────── *@
        <div class="tab-pane fade" id="tab-locales">
            <div class="row">
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white border-0 fw-semibold">Enabled Locales</div>
                        <div class="card-body p-4">
                            <p class="text-muted small mb-3">
                                Define which locales are available for this site's content.
                            </p>
                            @* Emit individual inputs that MVC can bind to List<string> *@
                            <div id="localesContainer">
                                @foreach (var locale in Model.Locales)
                                {
                                    <div class="input-group input-group-sm mb-2 locale-row">
                                        <input type="text" name="Locales" value="@locale"
                                               class="form-control font-monospace" placeholder="en" />
                                        <button type="button" class="btn btn-outline-danger remove-locale">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                            <button type="button" class="btn btn-outline-secondary btn-sm mt-2" id="addLocale">
                                <i class="bi bi-plus me-1"></i>Add Locale
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ── CORS tab ─────────────────────────────────────────────────────────────── *@
        <div class="tab-pane fade" id="tab-cors">
            <div class="row">
                <div class="col-lg-7">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white border-0 fw-semibold">
                            <i class="bi bi-shield-check me-2 text-primary"></i>Allowed Origins
                        </div>
                        <div class="card-body p-4">
                            <p class="text-muted small mb-3">
                                Add origins allowed to access this site's API.
                                Use <code>*</code> to allow all origins (not recommended for production).
                            </p>
                            <div id="corsContainer">
                                @foreach (var origin in Model.CorsOrigins)
                                {
                                    <div class="input-group input-group-sm mb-2 cors-row">
                                        <input type="text" name="CorsOrigins" value="@origin"
                                               class="form-control font-monospace" placeholder="https://myapp.com" />
                                        <button type="button" class="btn btn-outline-danger remove-cors">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                            <button type="button" class="btn btn-outline-secondary btn-sm mt-2" id="addCors">
                                <i class="bi bi-plus me-1"></i>Add Origin
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ── API Keys tab (no form inputs — info only) ────────────────────────────── *@
        <div class="tab-pane fade" id="tab-apikeys">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0 fw-semibold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-key me-2 text-primary"></i>API Keys</span>
                    <button type="button" class="btn btn-primary btn-sm"
                            data-bs-toggle="modal" data-bs-target="#newKeyModal">
                        <i class="bi bi-plus me-1"></i>Create Key
                    </button>
                </div>
                <div class="card-body">
                    <div class="alert alert-info d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-info-circle-fill flex-shrink-0"></i>
                        <span class="small">API keys grant read access to the Content Delivery API. Store keys securely — they are shown only once after creation.</span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold small text-muted text-uppercase">Site ID</label>
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control font-monospace" value="@site?.Id"
                                       id="siteIdCopy" readonly />
                                <button type="button" class="btn btn-outline-secondary" onclick="copyField('siteIdCopy')">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold small text-muted text-uppercase">Handle</label>
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control font-monospace" value="@site?.Handle"
                                       id="handleCopy" readonly />
                                <button type="button" class="btn btn-outline-secondary" onclick="copyField('handleCopy')">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="text-center py-4 text-muted border rounded-2">
                        <i class="bi bi-key" style="font-size:2rem;"></i>
                        <p class="mt-2 mb-0 small">No API keys yet. Create one to integrate your front-end.</p>
                    </div>
                </div>
            </div>
        </div>

    </div>

    @* ── Save button (visible outside tabs so it's always accessible) ─────────── *@
    <div id="saveBar" class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-save me-1"></i>Save Settings
        </button>
        <a asp-controller="Tenants" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>

</form>

@* ── Create API Key modal ─────────────────────────────────────────────────────── *@
<div class="modal fade" id="newKeyModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Create API Key</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Key Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" placeholder="e.g. Production Frontend" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Permissions</label>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="permRead" checked />
                        <label class="form-check-label" for="permRead">Read — Content Delivery API</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="permPreview" />
                        <label class="form-check-label" for="permPreview">Preview — Draft content</label>
                    </div>
                </div>
                <div class="alert alert-warning small mb-0">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    The key is shown only once. Copy it immediately after creation.
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" data-bs-dismiss="modal">Create Key</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Hide save bar when API keys tab is active (no form fields there)
        const saveBar = document.getElementById('saveBar');
        document.querySelectorAll('[data-bs-toggle="tab"]').forEach(function (btn) {
            btn.addEventListener('shown.bs.tab', function () {
                saveBar.style.display = this.dataset.bsTarget === '#tab-apikeys' ? 'none' : '';
            });
        });

        // Dynamic locale rows
        document.getElementById('addLocale').addEventListener('click', function () {
            const row = document.createElement('div');
            row.className = 'input-group input-group-sm mb-2 locale-row';
            row.innerHTML = '<input type="text" name="Locales" class="form-control font-monospace" placeholder="en" />'
                          + '<button type="button" class="btn btn-outline-danger remove-locale"><i class="bi bi-x"></i></button>';
            document.getElementById('localesContainer').appendChild(row);
        });

        // Dynamic CORS rows
        document.getElementById('addCors').addEventListener('click', function () {
            const row = document.createElement('div');
            row.className = 'input-group input-group-sm mb-2 cors-row';
            row.innerHTML = '<input type="text" name="CorsOrigins" class="form-control font-monospace" placeholder="https://myapp.com" />'
                          + '<button type="button" class="btn btn-outline-danger remove-cors"><i class="bi bi-x"></i></button>';
            document.getElementById('corsContainer').appendChild(row);
        });

        // Remove row handlers (delegated)
        document.addEventListener('click', function (e) {
            if (e.target.closest('.remove-locale')) e.target.closest('.locale-row').remove();
            if (e.target.closest('.remove-cors'))   e.target.closest('.cors-row').remove();
        });

        // Copy to clipboard
        function copyField(id) {
            const el = document.getElementById(id);
            if (!el) return;
            navigator.clipboard.writeText(el.value).then(() => {
                const btn = el.nextElementSibling;
                if (btn) {
                    btn.innerHTML = '<i class="bi bi-check"></i>';
                    setTimeout(() => btn.innerHTML = '<i class="bi bi-clipboard"></i>', 1500);
                }
            });
        }
    </script>
}
