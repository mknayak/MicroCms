@using MicroCMS.Admin.Mvc.Models.ApiDtos
@model List<ComponentItemDto>
@{
    var component = ViewBag.Component as ComponentDto;
    ViewData["Title"] = $"{component?.Name} — Items";
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-action="Index">Components</a></li>
            <li class="breadcrumb-item"><a asp-action="Detail" asp-route-id="@component?.Id">@component?.Name</a></li>
            <li class="breadcrumb-item active">Items</li>
        </ol>
    </nav>
    <h1 class="h4 fw-bold mb-0">@component?.Name — Items</h1>
</div>

@if (Model.Count == 0)
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-collection" style="font-size:2.5rem;"></i>
        <p class="mt-2">No items yet.</p>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Slug</th>
                        <th>Status</th>
                        <th>Updated</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><code class="small">@item.Slug</code></td>
                            <td>@await Html.PartialAsync("_StatusBadge", item.Status)</td>
                            <td><small class="text-muted">@item.UpdatedAt[..10]</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
