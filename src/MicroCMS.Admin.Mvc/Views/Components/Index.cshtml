@using MicroCMS.Admin.Mvc.Models.ApiDtos
@model List<ComponentListItem>
@{
    ViewData["Title"] = "Component Library";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h4 fw-bold mb-0">Component Library</h1>
        <small class="text-muted">@ViewBag.TotalPages pages</small>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-circle me-1"></i>New Component
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-puzzle" style="font-size:2.5rem;"></i>
        <p class="mt-2">No components yet.</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var comp in Model)
        {
            <div class="col-sm-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="fw-bold mb-0">@comp.Name</h6>
                            <span class="badge bg-light text-dark border">@comp.Category</span>
                        </div>
                        <code class="small text-muted d-block mb-2">@comp.Key</code>
                        @if (!string.IsNullOrWhiteSpace(comp.Description))
                        {
                            <p class="small text-muted mb-2">@comp.Description</p>
                        }
                        <div class="d-flex gap-2">
                            <small class="text-muted"><i class="bi bi-list-ul me-1"></i>@comp.FieldCount fields</small>
                            <small class="text-muted"><i class="bi bi-collection me-1"></i>@comp.ItemCount items</small>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 d-flex gap-2 pt-0">
                        <a asp-action="Detail" asp-route-id="@comp.Id" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-eye me-1"></i>Details
                        </a>
                        <a asp-action="Items" asp-route-id="@comp.Id" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-collection me-1"></i>Items
                        </a>
                        <form asp-action="Delete" method="post" class="d-inline ms-auto"
                              onsubmit="return confirm('Delete @comp.Name?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@comp.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    @await Html.PartialAsync("_Pagination", (PageNumber: (int)ViewBag.PageNumber, TotalPages: (int)ViewBag.TotalPages, RouteKey: "page", RouteValues: (object)new { }))
}
