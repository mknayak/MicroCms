@using System.Security.Claims
@{
    var displayName = User.FindFirst(ClaimTypes.Name)?.Value ?? "Admin";
    var email = User.FindFirst(ClaimTypes.Email)?.Value ?? string.Empty;
    var initials = string.IsNullOrWhiteSpace(displayName)
        ? "A"
        : string.Concat(displayName.Split(' ').Take(2).Select(w => w[0])).ToUpperInvariant();
}

<nav class="navbar navbar-dark bg-dark px-3 sticky-top shadow-sm" style="z-index: 1030;">
    <div class="d-flex align-items-center gap-3 w-100">

        @* Brand *@
        <a class="navbar-brand fw-bold me-3" asp-controller="Dashboard" asp-action="Index">
            <i class="bi bi-grid-3x3-gap-fill me-1 text-primary"></i>MicroCMS
        </a>

        @* Global search *@
        <form class="d-flex flex-grow-1" asp-controller="Search" asp-action="Index" method="get">
            <div class="input-group input-group-sm" style="max-width: 480px;">
                <span class="input-group-text bg-secondary border-0 text-white-50">
                    <i class="bi bi-search"></i>
                </span>
                <input type="search" name="q" class="form-control bg-secondary border-0 text-white"
                       placeholder="Search entries…" value="@Context.Request.Query["q"]"
                       autocomplete="off" />
            </div>
        </form>

        @* User menu *@
        <div class="dropdown ms-auto">
            <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2"
                    type="button" data-bs-toggle="dropdown">
                <span class="avatar-circle bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center"
                      style="width:28px;height:28px;font-size:.75rem;font-weight:700;">
                    @initials
                </span>
                <span class="d-none d-md-inline text-white-50">@displayName</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow">
                <li><h6 class="dropdown-header text-truncate" style="max-width:220px;">@email</h6></li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="dropdown-item text-danger">
                            <i class="bi bi-box-arrow-right me-2"></i>Sign out
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</nav>
