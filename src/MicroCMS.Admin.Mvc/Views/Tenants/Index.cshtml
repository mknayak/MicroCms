@model TenantsViewModel
@{
    ViewData["Title"] = "Tenants";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h4 fw-bold mb-0">Tenants</h1>
        <small class="text-muted">@Model.TotalCount tenant(s)</small>
    </div>
    <a asp-action="Onboard" class="btn btn-primary btn-sm">
        <i class="bi bi-building-add me-1"></i>Onboard Tenant
    </a>
</div>

@if (Model.Items.Count == 0)
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-building" style="font-size:2.5rem;"></i>
        <p class="mt-2">No tenants found.</p>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Slug</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tenant in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@tenant.DisplayName</td>
                            <td><code class="small text-muted">@tenant.Slug</code></td>
                            <td>@await Html.PartialAsync("_StatusBadge", tenant.Status)</td>
                            <td><small class="text-muted">@tenant.CreatedAt[..10]</small></td>
                            <td class="text-end">
                                <a asp-action="Detail" asp-route-id="@tenant.Id"
                                   class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-eye me-1"></i>View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @await Html.PartialAsync("_Pagination", (PageNumber: Model.PageNumber, TotalPages: Model.TotalPages, RouteKey: "page", RouteValues: (object)new { }))
}
