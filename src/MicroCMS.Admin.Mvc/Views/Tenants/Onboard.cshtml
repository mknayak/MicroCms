@using MicroCMS.Admin.Mvc.Models.ApiDtos
@model OnboardTenantRequest
@{
    ViewData["Title"] = "Onboard Tenant";
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-action="Index">Tenants</a></li>
            <li class="breadcrumb-item active">Onboard</li>
        </ol>
    </nav>
    <h1 class="h4 fw-bold mb-0">Onboard New Tenant</h1>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Onboard" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <h6 class="fw-semibold text-muted mb-3">Tenant Details</h6>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold">Display Name</label>
                            <input asp-for="DisplayName" class="form-control" placeholder="Acme Corp" required />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold">Slug</label>
                            <input asp-for="Slug" class="form-control font-monospace" placeholder="acme" required />
                        </div>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold">Default Locale</label>
                            <input asp-for="DefaultLocale" class="form-control" placeholder="en" value="en" required />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold">Time Zone</label>
                            <input asp-for="TimeZoneId" class="form-control" placeholder="UTC" value="UTC" required />
                        </div>
                    </div>

                    <hr />
                    <h6 class="fw-semibold text-muted mb-3">Admin Account</h6>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold">Admin Email</label>
                            <input asp-for="AdminEmail" class="form-control" placeholder="admin@acme.com" required />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold">Admin Name</label>
                            <input asp-for="AdminDisplayName" class="form-control" placeholder="Acme Admin" required />
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Default Site Name</label>
                        <input asp-for="DefaultSiteName" class="form-control" placeholder="Acme Website" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-building-add me-1"></i>Onboard Tenant
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
