@model UsersViewModel
@{
    ViewData["Title"] = "Users";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h4 fw-bold mb-0">Users</h1>
        <small class="text-muted">@Model.TotalCount user(s)</small>
    </div>
    <a asp-action="Invite" class="btn btn-primary btn-sm">
        <i class="bi bi-person-plus me-1"></i>Invite User
    </a>
</div>

@if (Model.Items.Count == 0)
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-people" style="font-size:2.5rem;"></i>
        <p class="mt-2">No users found.</p>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Roles</th>
                        <th>Status</th>
                        <th>Last Login</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Items)
                    {
                        var initials = string.Concat(user.DisplayName.Split(' ').Take(2).Select(w => w[0])).ToUpperInvariant();
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="avatar-circle bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                         style="width:34px;height:34px;font-size:.8rem;font-weight:700;">
                                        @initials
                                    </div>
                                    <span class="fw-semibold">@user.DisplayName</span>
                                </div>
                            </td>
                            <td><small class="text-muted">@user.Email</small></td>
                            <td>
                                @foreach (var role in user.Roles)
                                {
                                    var roleCss = role switch
                                    {
                                        "SystemAdmin"  => "bg-danger text-white",
                                        "TenantAdmin"  => "bg-primary text-white",
                                        "SiteAdmin"    => "bg-info text-white",
                                        "Designer"     => "bg-purple text-white",
                                        "Editor"       => "bg-success text-white",
                                        "Contributor"  => "bg-warning text-dark",
                                        _              => "bg-light text-dark border"
                                    };
                                    <span class="badge @roleCss me-1" style="@(role == "Designer" ? "background:#6f42c1 !important;" : "")">@role</span>
                                }
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td><small class="text-muted">@(user.LastLoginAt?[..10] ?? "—")</small></td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    @if (user.IsActive)
                                    {
                                        <form asp-action="Deactivate" method="post" class="d-inline"
                                              onsubmit="return confirm('Deactivate @user.DisplayName?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="btn btn-outline-warning" title="Deactivate">
                                                <i class="bi bi-person-dash"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Activate" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="btn btn-outline-success" title="Activate">
                                                <i class="bi bi-person-check"></i>
                                            </button>
                                        </form>
                                    }
                                    @if (User.IsInRole("SystemAdmin"))
                                    {
                                        <form asp-action="Delete" method="post" class="d-inline"
                                              onsubmit="return confirm('Permanently delete @user.DisplayName?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @await Html.PartialAsync("_Pagination", (PageNumber: Model.PageNumber, TotalPages: Model.TotalPages, RouteKey: "page", RouteValues: (object)new { }))
}
