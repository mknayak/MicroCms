@model MediaViewModel
@{
    ViewData["Title"] = "Media Library";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h4 fw-bold mb-0">Media Library</h1>
    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#uploadModal">
        <i class="bi bi-cloud-upload me-1"></i>Upload
    </button>
</div>

@* ── Folder breadcrumb + filter ──────────────────────────────────────────────── *@
<form asp-action="Index" method="get" class="row g-2 mb-3">
    <input type="hidden" name="folderId" value="@Model.CurrentFolderId" />
    <div class="col-sm-4">
        <input type="search" name="search" value="@Model.SearchQuery"
               class="form-control form-control-sm" placeholder="Search files…" />
    </div>
    <div class="col-sm-2">
        <select name="mediaType" class="form-select form-select-sm">
            <option value="">All types</option>
            <option value="image" selected="@("image" == Model.MediaTypeFilter)">Images</option>
            <option value="video" selected="@("video" == Model.MediaTypeFilter)">Videos</option>
            <option value="document" selected="@("document" == Model.MediaTypeFilter)">Documents</option>
            <option value="audio" selected="@("audio" == Model.MediaTypeFilter)">Audio</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary btn-sm">
            <i class="bi bi-funnel me-1"></i>Filter
        </button>
    </div>
</form>

<div class="row g-3">
    @* ── Folder sidebar ─────────────────────────────────────────────────────── *@
    <div class="col-md-3 col-lg-2">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold border-0 d-flex justify-content-between align-items-center small">
                <span><i class="bi bi-folder2 me-1"></i>Folders</span>
                <button type="button" class="btn btn-link btn-sm p-0" data-bs-toggle="modal" data-bs-target="#newFolderModal">
                    <i class="bi bi-plus"></i>
                </button>
            </div>
            <ul class="list-group list-group-flush small">
                <li class="list-group-item @(string.IsNullOrEmpty(Model.CurrentFolderId) ? "active" : "")">
                    <a asp-action="Index" class="text-decoration-none @(string.IsNullOrEmpty(Model.CurrentFolderId) ? "text-white" : "")">
                        <i class="bi bi-house me-1"></i>All Files
                    </a>
                </li>
                @foreach (var folder in Model.Folders)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center @(folder.Id == Model.CurrentFolderId ? "active" : "")">
                        <a asp-action="Index" asp-route-folderId="@folder.Id"
                           class="text-decoration-none text-truncate @(folder.Id == Model.CurrentFolderId ? "text-white" : "")"
                           style="max-width:110px;" title="@folder.Name">
                            <i class="bi bi-folder me-1"></i>@folder.Name
                        </a>
                        <form asp-action="DeleteFolder" method="post" class="d-inline"
                              onsubmit="return confirm('Delete folder @folder.Name?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@folder.Id" />
                            <input type="hidden" name="parentFolderId" value="@folder.ParentFolderId" />
                            <button type="submit" class="btn btn-link btn-sm p-0 text-danger">
                                <i class="bi bi-x"></i>
                            </button>
                        </form>
                    </li>
                }
            </ul>
        </div>
    </div>

    @* ── Asset grid ─────────────────────────────────────────────────────────── *@
    <div class="col-md-9 col-lg-10">
        @if (Model.Assets.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-images" style="font-size:2.5rem;"></i>
                <p class="mt-2">No assets found.</p>
            </div>
        }
        else
        {
            <div class="row row-cols-2 row-cols-sm-3 row-cols-lg-4 row-cols-xl-5 g-3">
                @foreach (var asset in Model.Assets)
                {
                    <div class="col">
                        <div class="card border-0 shadow-sm h-100 asset-card">
                            @* Thumbnail *@
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center overflow-hidden"
                                 style="height:120px;">
                                @if (asset.MediaType == "image" && !string.IsNullOrWhiteSpace(asset.ThumbnailUrl ?? asset.Url))
                                {
                                    <img src="@(asset.ThumbnailUrl ?? asset.Url)" alt="@asset.AltText"
                                         class="img-fluid object-fit-cover w-100 h-100" loading="lazy" />
                                }
                                else
                                {
                                    var iconClass = asset.MediaType switch
                                    {
                                        "video"    => "bi-camera-video",
                                        "audio"    => "bi-music-note",
                                        "document" => "bi-file-earmark-text",
                                        _          => "bi-file-earmark",
                                    };
                                    <i class="bi @iconClass text-muted" style="font-size:2rem;"></i>
                                }
                            </div>
                            <div class="card-body p-2">
                                <p class="card-text text-truncate small fw-semibold mb-0" title="@asset.FileName">
                                    @asset.FileName
                                </p>
                                <small class="text-muted">@(asset.FileSize / 1024) KB</small>
                            </div>
                            <div class="card-footer bg-transparent border-0 p-2 text-end">
                                <form asp-action="Delete" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete @asset.FileName?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@asset.Id" />
                                    <input type="hidden" name="folderId" value="@Model.CurrentFolderId" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @await Html.PartialAsync("_Pagination", (
                PageNumber: Model.PageNumber,
                TotalPages: Model.TotalPages,
                RouteKey: "page",
                RouteValues: (object)new { folderId = Model.CurrentFolderId, search = Model.SearchQuery, mediaType = Model.MediaTypeFilter }
            ))
        }
    </div>
</div>

@* ── Upload modal ───────────────────────────────────────────────────────────── *@
<div class="modal fade" id="uploadModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Upload File</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Upload" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="folderId" value="@Model.CurrentFolderId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">File</label>
                        <input type="file" name="file" class="form-control" accept="image/*,video/*,audio/*,.pdf,.doc,.docx" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Alt Text <span class="text-muted fw-normal">(images)</span></label>
                        <input type="text" name="altText" class="form-control" placeholder="Describe the image…" />
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bi bi-cloud-upload me-1"></i>Upload
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── New folder modal ────────────────────────────────────────────────────────── *@
<div class="modal fade" id="newFolderModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">New Folder</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateFolder" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="parentFolderId" value="@Model.CurrentFolderId" />
                <div class="modal-body">
                    <input type="text" name="name" class="form-control" placeholder="Folder name" required />
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>
