{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection":  "Host=localhost;Port=5433;Database=microcms_db;Username=postgres;Password=M@n@s0000"
    },
    "MicroCMS": {
        "Database": {
            "Provider": "POSTGRESQL",
            "IsolationMode": "RowLevel"
        },
        "Outbox": {
            "InstanceId": "CD-01"
        },
        "Storage": {
            "Provider": "Filesystem",
            "Filesystem": {
                "BasePath": "./uploads"
            }
        },
        "Cache": {
            "Provider": "None"
        },
        "Search": {
            "Provider": "Database"
        }
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "System": "Warning"
            }
        },
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "File",
                "Args": {
                    "path": "App_Data/logs/log-.txt",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 14,
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
                }
            }
        ]
    }
}
