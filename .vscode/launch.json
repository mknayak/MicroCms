    "version": "0.2.0",
    "configurations": [
        {
            "name": "MicroCMS.Delivery.WebHost",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/src/MicroCMS.Delivery.WebHost/MicroCMS.Delivery.WebHost.csproj",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/swagger"
            }
        }
    ]
}